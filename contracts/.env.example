# ConsentCraftMarket deployment and smoke-test settings for Sepolia.
# Copy to contracts/.env (git-ignored) and fill in. Never commit real keys.
# Prefer the Hardhat keystore for the deployer key and API key instead of this file:
#   cd contracts && npx hardhat keystore set SEPOLIA_DEPLOYER_PRIVATE_KEY
# The keystore is checked first; environment variables are the fallback.

# --- Network and deployer ------------------------------------------------------------
# HTTPS RPC endpoint for Sepolia (Alchemy, Infura, etc.).
SEPOLIA_RPC_URL=
# Deployer key (0x + 64 hex). Pays deployment gas (~0.02-0.05 Sepolia ETH). Holds no role afterwards
# when ADMIN_ADDRESS is set to a different address.
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Etherscan API key, for `npm run contracts:verify:sepolia`.
ETHERSCAN_API_KEY=

# --- Roles and recipients granted by the deploy script (addresses) ----------------------
# Final DEFAULT_ADMIN_ROLE holder. Use a multisig for anything beyond a demo.
# Leave empty to keep the deployer as admin.
ADMIN_ADDRESS=
# Receives platform fees and owner allocations (as withdrawable credits).
OWNER_RECIPIENT=
# Receives recognized AI costs (as withdrawable credits).
AI_EXPENSE_RECIPIENT=
# Backend key that signs PublicationQuote and PersonhoodCertificate.
QUOTE_SIGNER_ADDRESS=
# Backend key that signs ReviewReport.
REPORTER_ADDRESS=
# Account that resolves appeals. Keep separate from the owner recipient where feasible.
REVIEWER_ADDRESS=
# Account that can pause new deposits and purchases.
PAUSER_ADDRESS=

# --- Smoke test (npm run contracts:smoke:sepolia) ------------------------------------------
# Optional; defaults to the address in deployments/sepolia.json.
MARKET_ADDRESS=
# Private keys matching QUOTE_SIGNER_ADDRESS and REPORTER_ADDRESS (the smoke test signs
# off-chain messages as the backend would).
QUOTE_SIGNER_PRIVATE_KEY=
REPORTER_PRIVATE_KEY=
# Two separate funded test wallets: author needs ~0.0015 ETH, buyer ~0.0005 ETH.
SMOKE_AUTHOR_PRIVATE_KEY=
SMOKE_BUYER_PRIVATE_KEY=
# Optional real Arweave data. Without these, labeled TEST PLACEHOLDERS are recorded on chain.
ARWEAVE_BUNDLE_TX_ID=
ARWEAVE_PREVIEW_TX_ID=
MANIFEST_HASH=
PREVIEW_MANIFEST_HASH=
