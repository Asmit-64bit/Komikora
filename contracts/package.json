{
  "name": "@consentcraft/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "3.21.2"
  },
  "scripts": {
    "compile": "node ../node_modules/hardhat/dist/src/cli.js build",
    "node": "node ../node_modules/hardhat/dist/src/cli.js node --hostname 127.0.0.1",
    "test": "node ../node_modules/hardhat/dist/src/cli.js test",
    "typecheck": "node ../node_modules/hardhat/dist/src/cli.js build --quiet && node ../node_modules/typescript/bin/tsc --noEmit",
    "abi:export": "node ../node_modules/hardhat/dist/src/cli.js run scripts/export-abi.ts",
    "deploy:sepolia": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network sepolia scripts/deploy.ts",
    "smoke:sepolia": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network sepolia scripts/smoke-sepolia.ts",
    "verify:sepolia": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js verify --network sepolia",
    "deploy:local": "node --env-file=local-node.env ../node_modules/hardhat/dist/src/cli.js run --network localhost scripts/deploy.ts",
    "smoke:local": "node --env-file=local-node.env ../node_modules/hardhat/dist/src/cli.js run --network localhost scripts/smoke-sepolia.ts",
    "record-indexer-fixture": "node ../node_modules/hardhat/dist/src/cli.js run scripts/record-indexer-fixture.ts",
    "abi:editions": "node ../node_modules/hardhat/dist/src/cli.js run scripts/export-editions.ts",
    "deploy:editions:local": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network localhost scripts/deploy-editions.ts",
    "deploy:editions:sepolia": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network sepolia scripts/deploy-editions.ts",
    "deploy:registry:galileo": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network ogGalileo scripts/deploy-registry.ts",
    "abi:reading": "node ../node_modules/hardhat/dist/src/cli.js run scripts/export-reading.ts",
    "deploy:reading:sepolia": "node --env-file-if-exists=.env ../node_modules/hardhat/dist/src/cli.js run --network sepolia scripts/deploy-reading.ts"
  }
}
