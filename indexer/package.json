{
  "name": "@consentcraft/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projects confirmed ConsentCraftMarket events into Arkiv listing and trade entities.",
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "scripts": {
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:live": "ARKIV_LIVE=1 node --env-file-if-exists=.env --test --test-reporter=spec test/live-arkiv.test.ts",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "editions": "node --env-file-if-exists=.env src/editions.ts"
  }
}
