# ConsentCraft Arkiv indexer. Copy to indexer/.env (git-ignored) and fill in.

# --- Source chain (where ConsentCraftMarket lives) ----------------------------------------
# Sepolia RPC used to read contract events. Required for backfill, watch and renew.
INDEXER_SOURCE_RPC_URL=
# Defaults come from ../contracts/deployments/sepolia.json once the contract is deployed.
# INDEXER_DEPLOYMENT_FILE=../contracts/deployments/sepolia.json
# INDEXER_MARKET_ADDRESS=
# INDEXER_SOURCE_CHAIN_ID=11155111
# INDEXER_START_BLOCK=
# Blocks a log must be buried under before it is indexed.
INDEXER_CONFIRMATIONS=12
# INDEXER_BATCH_BLOCKS=2000
# INDEXER_POLL_MS=12000

# --- Arkiv (Rabdi testnet, chain 7794095) -----------------------------------------------------
# Free access key from https://hub.arkiv.network/access-keys (without one, the public endpoint is
# heavily rate limited). Goes into the RPC URL path.
ARKIV_ACCESS_KEY=
# Entity-writing wallet. Fund it with test tGLM at https://hub.arkiv.network/faucet.
# Use a dedicated key: it owns every listing and trade entity.
ARKIV_PRIVATE_KEY=
# For read-only queries without the key (judges, frontend): the writer's address.
ARKIV_WRITER_ADDRESS=
# Entity lifetime and renewal window. Arkiv allows at most ~182 days.
# ARKIV_ENTITY_TTL_DAYS=180
# ARKIV_RENEW_BEFORE_DAYS=30

# --- Arweave ----------------------------------------------------------------------------------
# Gateway used to fetch public preview manifests (verified against previewManifestHash).
# ARWEAVE_GATEWAY=https://arweave.net
