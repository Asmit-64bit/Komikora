# Copy with npm run env:setup. All service values below are development-only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Basic studio storage: .data/<namespace>/studio.json (one Node process).
CONSENTCRAFT_DATA_NAMESPACE=studio
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=

# Private SQL storage and PostgreSQL-backed durable jobs (pg-boss).
POSTGRES_USER=consentcraft
POSTGRES_PASSWORD=consentcraft_local_only
POSTGRES_DB=consentcraft
DATABASE_URL=postgresql://consentcraft:consentcraft_local_only@127.0.0.1:15432/consentcraft

# Local S3-compatible storage. The bucket is private by default.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=consentcraft-private
S3_ACCESS_KEY_ID=consentcraft
S3_SECRET_ACCESS_KEY=consentcraft_local_only
S3_FORCE_PATH_STYLE=true

# Generated locally by env:setup. Never use NEXT_PUBLIC_ for secrets.
SESSION_SECRET=

# ── dApp: ConsentCraftMarket ────────────────────────────────────────────────
# Chain and contract. NEXT_PUBLIC_* values are compiled into the browser bundle,
# so rebuild after changing them. Local: npm run contracts:node + contracts:deploy:local.
# Sepolia: chain 11155111, address from contracts/deployments/sepolia.json.
APP_ORIGIN=http://localhost:3000
CHAIN_RPC_URL=
MARKET_START_BLOCK=0
NEXT_PUBLIC_MARKET_START_BLOCK=0
CHAIN_CONFIRMATIONS=

# Server signing keys (0x + 64 hex). Never prefix these with NEXT_PUBLIC_.
# Their addresses must hold the matching contract roles (see contracts/.env.example).
QUOTE_SIGNER_PRIVATE_KEY=
REPORTER_PRIVATE_KEY=
# Any funded account; pays gas to relay signed review reports.
RELAYER_PRIVATE_KEY=
# 32 random bytes. Encrypts every comic's content key at rest. Losing it locks all paid pages.
CONTENT_KEY_ENCRYPTION_KEY=

# Publication quote terms (wei). The deposit must exceed the AI cap.
PUBLISH_DEPOSIT_WEI=5000000000000000
PUBLISH_AI_CAP_WEI=500000000000000
PUBLISH_POLICY_ID=1

# Arweave via an ar.io Turbo bundler. Defaults: the ar.io testnet sandbox (free up
# to 5 MiB per item). Any EVM key works for free uploads; it is only an uploader identity.
ARWEAVE_UPLOAD_PRIVATE_KEY=
ARWEAVE_UPLOAD_URL=https://upload.services.ar-io.dev
ARWEAVE_PAYMENT_URL=https://payment.services.ar-io.dev
ARWEAVE_GATEWAY=https://ar-io.dev

# World ID 4. Create an app and an action at https://developer.world.org.
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=consentcraft-verify-account
WORLD_ENVIRONMENT=production

# 0G Compute (Direct mode) for AI review. Fund ZG_PRIVATE_KEY with 0G tokens, then
# run npm run zg -- setup. Testnet RPC https://evmrpc-testnet.0g.ai (chain 16602).
ZG_PRIVATE_KEY=
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# Must be a TEE-verifiable chatbot that accepts images (list them with npm run zg -- providers).
ZG_PROVIDER_ADDRESS=
ZG_MODEL=
# ETH value of one 0G token, used to convert the real 0G bill into the on-chain AI cost.
ZG_ETH_PER_0G=

# Arkiv index (the indexer has its own env: indexer/.env.example).
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
