{
  "name": "eth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "rpc-websockets": {
      "uuid": "11.1.1"
    },
    "valtio@1.13.2": {
      "use-sync-external-store": "1.4.0"
    }
  },
  "workspaces": [
    "contracts",
    "indexer"
  ],
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit && npm run typecheck --workspace @consentcraft/contracts && npm run typecheck --workspace @consentcraft/indexer",
    "check": "npm run lint && npm run typecheck",
    "env:setup": "node scripts/setup-env.mjs",
    "services:up": "docker compose --env-file .env.local up -d --wait",
    "services:down": "docker compose --env-file .env.local down",
    "services:status": "docker compose --env-file .env.local ps",
    "services:init": "node --env-file=.env.local scripts/init-services.mjs",
    "contracts:compile": "npm run compile --workspace @consentcraft/contracts",
    "contracts:node": "npm run node --workspace @consentcraft/contracts",
    "contracts:test": "npm run test --workspace @consentcraft/contracts",
    "contracts:abi": "npm run abi:export --workspace @consentcraft/contracts",
    "contracts:deploy:local": "npm run deploy:local --workspace @consentcraft/contracts",
    "contracts:smoke:local": "npm run smoke:local --workspace @consentcraft/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia --workspace @consentcraft/contracts",
    "contracts:smoke:sepolia": "npm run smoke:sepolia --workspace @consentcraft/contracts",
    "contracts:verify:sepolia": "npm run verify:sepolia --workspace @consentcraft/contracts --",
    "indexer": "npm run cli --workspace @consentcraft/indexer --",
    "indexer:test": "npm run test --workspace @consentcraft/indexer",
    "indexer:test:live": "npm run test:live --workspace @consentcraft/indexer",
    "zg": "node --env-file-if-exists=.env.local scripts/zg.mjs",
    "contracts:record-indexer-fixture": "npm run record-indexer-fixture --workspace @consentcraft/contracts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:backend": "node tests/integration/studio.mjs",
    "test:dapp": "node tests/integration/dapp-local.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node node_modules/@playwright/test/cli.js install chromium",
    "editions:abi": "npm run abi:editions --workspace @consentcraft/contracts",
    "editions:deploy:local": "npm run deploy:editions:local --workspace @consentcraft/contracts",
    "editions:deploy:sepolia": "npm run deploy:editions:sepolia --workspace @consentcraft/contracts",
    "editions:index": "npm run editions --workspace @consentcraft/indexer --",
    "test:editions": "node tests/integration/editions-local.mjs",
    "reading:abi": "npm run abi:reading --workspace @consentcraft/contracts",
    "reading:deploy:sepolia": "npm run deploy:reading:sepolia --workspace @consentcraft/contracts",
    "test:reading": "node tests/integration/reading-local.mjs",
    "heirloom:abi": "npm run abi:heirloom --workspace @consentcraft/contracts",
    "heirloom:deploy:local": "npm run deploy:heirloom:local --workspace @consentcraft/contracts",
    "heirloom:deploy:sepolia": "npm run deploy:heirloom:sepolia --workspace @consentcraft/contracts",
    "test:heirloom": "READING_TEST_HEIRLOOM=1 node tests/integration/reading-local.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.9.0",
    "@ardrive/turbo-sdk": "2.2.0",
    "@arkiv-network/sdk": "1.0.1",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@hookform/resolvers": "7.0.3",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.106.1",
    "circomlibjs": "0.1.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "crypto-js": "4.2.0",
    "ethers": "6.17.0",
    "fflate": "0.8.3",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pdfjs-dist": "5.4.394",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.57.16",
    "wagmi": "2.19.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
